{
  "genre": "modern",
  "name": "현대물",
  "worldbuilding": [
    "직장 생활: 현실적인 직장 내 이야기",
    "학원물: 학교와 청춘의 이야기",
    "가족 드라마: 가족 간의 갈등과 화해",
    "사회 고발: 현실의 문제를 다루는 이야기"
  ],
  "plot_templates": {
    "opening": [
      "{protagonist}는 {workplace}에서 일하는 {position}이었다.",
      "오늘도 {protagonist}의 일상은 {adjective}했다.",
      "{protagonist}의 삶에 변화가 찾아왔다. {event}가 일어난 것이다."
    ],
    "development": [
      "{protagonist}는 {challenge}에 직면했다.",
      "{character}의 등장으로 {protagonist}의 삶이 달라지기 시작했다.",
      "문제는 생각보다 복잡했다. {obstacle}이(가) {protagonist}를 막았다."
    ],
    "climax": [
      "{protagonist}는 결단을 내려야 했다. {choice}를 선택할 것인가?",
      "진실이 드러났다. {protagonist}가 알고 있던 모든 것이 흔들렸다.",
      "이제는 맞서야 할 때였다. {protagonist}는 {action}을(를) 결심했다."
    ],
    "resolution": [
      "{protagonist}는 {achievement}를 이루었다.",
      "삶은 계속되었다. 하지만 {protagonist}는 이제 {change}했다.",
      "새로운 시작이었다. {protagonist}의 앞에는 {future}가 펼쳐졌다."
    ]
  },
  "character_archetypes": {
    "protagonist": {
      "traits": ["현실적인", "노력하는", "솔직한", "열정적인", "평범한"],
      "backgrounds": ["회사원", "학생", "프리랜서", "창업자", "구직자"]
    },
    "mentor": {
      "traits": ["경험 많은", "현명한", "냉정한", "따뜻한"],
      "roles": ["상사", "선생님", "선배", "부모"]
    },
    "friend": {
      "traits": ["믿음직한", "유쾌한", "솔직한", "의리있는"],
      "roles": ["동료", "친구", "동기", "이웃"]
    },
    "antagonist": {
      "traits": ["권위적인", "이기적인", "냉혹한", "부패한"],
      "roles": ["상사", "경쟁자", "시스템", "사회"]
    }
  },
  "scene_templates": {
    "daily": [
      "{time}이었다. {protagonist}는 {action}을(를) 하고 있었다.",
      "{place}는 {adjective} 분위기였다.",
      "{character}의 표정이 {emotion}로 일그러졌다."
    ],
    "dialogue": [
      "\"{dialogue1}\" {character1}이(가) 말했다.",
      "\"{dialogue2}\" {character2}이(가) 대답했다.",
      "침묵이 흘렀다. 서로의 생각을 정리할 시간이 필요했다."
    ],
    "conflict": [
      "{character1}과 {character2}의 의견이 부딪혔다.",
      "회의실 분위기가 얼어붙었다.",
      "{character}는 선택의 기로에 섰다."
    ]
  },
  "themes": [
    "성장: 시련을 극복하고 성장하는 이야기",
    "우정: 진정한 우정의 가치를 깨닫는 이야기",
    "꿈: 꿈을 향한 도전과 좌절, 그리고 성취",
    "정의: 불의에 맞서 싸우는 이야기",
    "가족: 가족의 소중함을 깨닫는 이야기"
  ],
  "conflicts": [
    "직장 내 갈등: 상사, 동료와의 마찰",
    "진로 고민: 미래에 대한 불안과 선택",
    "인간관계: 사람들과의 관계에서 오는 어려움",
    "사회 문제: 불공정, 차별, 부조리",
    "개인의 성장: 자아 발견과 변화"
  ]
}
